# ClauseIQ backend development configuration.
# Copy to backend/.env. Never commit that generated file.

ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=clauseiq
MONGODB_COLLECTION=documents
MONGODB_COLLECTION_PREFIX=

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=clauseiq-vectors
QDRANT_API_KEY=

MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=.pdf
STORAGE_DIR=./documents_storage

# Generate separate random values before using this outside local development:
#   openssl rand -hex 32
JWT_SECRET_KEY=change-me-local-jwt-secret-32-characters-minimum
API_KEY_ENCRYPTION_SECRET=change-me-local-encryption-secret-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Local development/testing accounts are marked verified without sending email.
# Staging and production always require verification, even if this is set false.
# Set true locally only when you have configured SMTP and want to test that flow.
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=ClauseIQ

# Optional, comma-separated accounts that can access the admin area.
ADMIN_EMAILS=

# ClauseIQ uses bring-your-own-key (BYOK). Users add their OpenAI key in the
# application settings; do not place an application-owner OpenAI key here.
