{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/prepare-pdf-assets.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/prepare-pdf-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:screenshots": "playwright test --grep showcase"
  },
  "dependencies": {
    "@clauseiq/shared-types": "file:../shared",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "15.5.24",
    "pdfjs-dist": "6.3.289",
    "postcss": "8.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.5.2",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^3.4.17",
    "zod": "^3.22.4"
  },
  "overrides": {
    "postcss": "$postcss",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.63.0",
    "@types/node": "^20",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.24",
    "typescript": "^5"
  }
}
